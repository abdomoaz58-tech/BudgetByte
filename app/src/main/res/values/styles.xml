<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- CardStyles -->
    <style name="FinCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardCornerRadius">@dimen/radius_medium</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divider</item>
    </style>

    <style name="FinCard.Elevated">
        <item name="cardElevation">@dimen/elevation_medium</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Typography -->
    <style name="FinText">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="FinText.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FinText.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FinText.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FinText.Subtitle">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FinText.Body">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="FinText.Caption">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Buttons -->
    <style name="FinButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FinButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Widget.BudgetByte.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/surface_container_lowest</item>
        <item name="android:minHeight">80dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemBackground">@drawable/nav_item_background</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextColor">@color/nav_item_tint</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
    </style>

    <style name="Widget.BudgetByte.PillButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">999dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.BudgetByte.Card.Elevated" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface_container_lowest</item>
    </style>

    <style name="Widget.BudgetByte.CategoryBadge" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">24dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Widget.BudgetByte.Chip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipCornerRadius">999dp</item>
        <item name="android:minHeight">36dp</item>
    </style>
</resources>

